#include "ui_debug.h"

namespace app_ui {

void UIDebug::BeginFrame(uint32_t timestamp_ms) {
    last_frame_ms_ = timestamp_ms;
}

void UIDebug::EndFrame() {
}

void UIDebug::SetEnabled(bool enabled) {
    enabled_ = enabled;
}

bool UIDebug::Enabled() const {
    return enabled_;
}

} // namespace app_ui
